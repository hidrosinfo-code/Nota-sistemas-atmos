# ─── VARIABLES DE ENTORNO ─────────────────────────────────────────────────────
# Copia este archivo como  .env.local  (ya está en .gitignore, NUNCA lo subas a GitHub)
#
# GEMINI_API_KEY  →  API key de Google AI Studio (https://aistudio.google.com/app/apikey)
# APP_PASSWORD    →  Contraseña que verá el usuario al abrir la app

GEMINI_API_KEY=PEGA_AQUI_TU_API_KEY_DE_GOOGLE
APP_PASSWORD=ELIGE_UNA_CONTRASENA_SEGURA
